{
  "_documentation": {
    "purpose": "Fiber estimation configuration for Barbora product scraper",
    "source": "Rimi Product Scraper project - fiber values based on USDA data and category analysis",
    "created": "2026-01-25",
    "usage": "Use category_id from your products table to look up default fiber values. Apply exception rules first (keyword match), then fall back to category defaults."
  },
  
  "_implementation_guide": {
    "step_1_add_column": {
      "description": "Add is_fiber_correct column to nutritionfacts table",
      "sql": "ALTER TABLE nutritionfacts ADD COLUMN is_fiber_correct BOOLEAN DEFAULT FALSE;",
      "note": "Default FALSE because most products don't have scraped fiber data"
    },
    "step_2_fix_existing_data": {
      "description": "Set is_fiber_correct=TRUE only for products that already have real fiber data",
      "sql": "UPDATE nutritionfacts SET is_fiber_correct = TRUE WHERE fiber IS NOT NULL AND fiber > 0;"
    },
    "step_3_logic": {
      "estimation_order": [
        "1. If product already has fiber > 0, skip (keep is_fiber_correct as is)",
        "2. Check exception_rules: if category_id prefix matches AND product name contains keyword, use exception fiber",
        "3. Otherwise use category_fiber_defaults[category_id]",
        "4. If no match found, fiber stays NULL"
      ],
      "is_fiber_correct_rules": {
        "TRUE": "Scraped fiber from website, USDA data, or manual entry",
        "FALSE": "Missing/null fiber, estimated values, or unverified data"
      }
    }
  },

