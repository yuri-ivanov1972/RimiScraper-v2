  "exception_rules": [
    {
      "category_id_prefix": "47",
      "category_description": "Rice (SH-4-16)",
      "keywords": ["Brūnie", "Integrālie", "Melnie"],
      "fiber": 3.5,
      "reason": "Whole grain rice has ~3x more fiber than white rice"
    },
    {
      "category_id_prefix": "48",
      "category_description": "Pasta (SH-4-11)",
      "keywords": ["Pilngraudu"],
      "fiber": 7.0,
      "reason": "Whole grain pasta - significant impact on Nutri-Score"
    },
    {
      "category_id_prefix": "36",
      "category_description": "Chocolate (SH-13-14)",
      "keywords": ["70%", "85%", "Melnā"],
      "fiber": 10.0,
      "reason": "Dark chocolate is a fiber powerhouse"
    },
    {
      "category_id_prefix": "397",
      "category_description": "Portion bread (SH-7-2-20)",
      "keywords": ["Sēklu", "Ar sēklām"],
      "fiber": 6.0,
      "reason": "Seeds add healthy fats and fiber"
    },
    {
      "category_id_prefix": "120",
      "category_description": "Yogurt with additions (SH-11-2-6)",
      "keywords": ["Musli", "Linsēklas"],
      "fiber": 1.5,
      "reason": "Standard yogurt is 0, but added grains improve the score"
    },
    {
      "category_id_prefix": "174",
      "category_description": "Cookies whole grain (SH-13-3-7)",
      "keywords": ["Pilngraudu", "Integrālie"],
      "fiber": 4.0,
      "reason": "Whole grain cookies have more fiber than regular"
    }
  ],

